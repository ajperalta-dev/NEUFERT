# Set variables in the shell before launching. No keys are needed for local hybrid search.
NEUFERT_DATA_DIR=./data
NEUFERT_OCR_LANG=deu
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# NEUFERT_API_URL=http://127.0.0.1:8000
NEUFERT_VISION_PROVIDER=openai
NEUFERT_VISION_MODEL=gpt-6-luna
NEUFERT_VERIFY_MODEL=gpt-6-luna
