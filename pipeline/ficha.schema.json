        "value": {
          "title": "Value",
          "type": "number"
        },
        "value_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Max"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "context": {
          "title": "Context",
          "type": "string"
        },
        "status": {
          "default": "uncertain",
          "enum": [
            "verified",
            "corrected",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "ocr_raw": {
          "title": "Ocr Raw",
          "type": "string"
        },
        "verification_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Level"
        },
        "verification_pass2": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Pass2"
        },
        "status_history": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Status History",
          "type": "array"
        },
        "original_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Value"
        }
      },
      "required": [
        "label",
        "value",
        "unit",
        "context",
        "ocr_raw"
      ],
      "title": "Dimension",
      "type": "object"
    },
